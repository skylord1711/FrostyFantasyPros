{
  "name": "frosty-fantasy-pros",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/index.mjs",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -p server/tsconfig.json",
    "check": "npm run typecheck && npm run build",
    "start": "npm run build:server && node server/dist/index.mjs",
    "dev": "npm run build:server && node --watch server/dist/index.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
